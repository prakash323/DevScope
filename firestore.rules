rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: User Profile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email']) 
        && data.uid is string && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && (!('gitUsername' in data) || (data.gitUsername is string && data.gitUsername.size() <= 100))
        && (!('leetcodeUsername' in data) || (data.leetcodeUsername is string && data.leetcodeUsername.size() <= 100))
        && (!('overallScore' in data) || (data.overallScore is int));
    }

    // Validation Blueprint: Activity Log
    function isValidActivityLog(data) {
      return data.keys().hasAll(['id', 'userId', 'action', 'module', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.action is string && data.action.size() <= 500
        && data.module in ['AUTH', 'GITHUB', 'LEETCODE', 'RESUME', 'ROADMAP', 'SYSTEM']
        && data.timestamp is string;
    }

    // Validation Blueprint: Calendar Event Reference
    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'startTime', 'endTime'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.startTime is string
        && data.endTime is string
        && (!('googleEventId' in data) || (data.googleEventId is string && data.googleEventId.size() <= 128));
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid && incoming().email == existing().email;
      allow delete: if false; // Profiles are permanent inside placement records

      // Subcollection: Activities (Placement logs)
      match /activities/{activityId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidActivityLog(incoming()) && incoming().userId == userId;
        allow update, delete: if false; // Logs are immutable audit trails
      }

      // Subcollection: Events (Mock Interviews & Schedules)
      match /events/{eventId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCalendarEvent(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidCalendarEvent(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
